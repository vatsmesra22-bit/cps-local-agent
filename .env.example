# Copy this file to `.env` and fill in what applies to this PC. `.env` is never committed or shared.
# Anything left empty falls back to config/settings.yaml, then to the built-in default.

# --- Reporting period (original WhatsApp message date, inclusive) -------------------------------
CSP_START_DATE=2026-09-22
# Empty = latest message date found in the inputs
CSP_END_DATE=
CSP_TIMEZONE=Asia/Kolkata

# --- Folders (relative to the project folder, or absolute) --------------------------------------
CSP_INPUT_DIR=input
CSP_OUTPUT_DIR=output
CSP_STATE_DB=data/state.sqlite
# New WhatsApp export zips saved here are copied into input/ by --auto-import
CSP_WATCH_FOLDER=~/Downloads
# Optional CSV with columns sender,role,district
CSP_REPORTER_DIRECTORY=

# --- OCR (reading text inside screenshots) ------------------------------------------------------
OCR_ENABLED=true
# Empty = auto-detect in the usual install folders
TESSERACT_CMD=
# Add +hin if the Hindi language pack is installed
OCR_LANGUAGES=eng

# --- WhatsApp Web safety lock for the scheduled agent -------------------------------------------
# The agent reads WhatsApp Web ONLY when the logged-in account matches BOTH values.
# While either is empty the agent does not read WhatsApp at all (exports are still processed).
WHATSAPP_ALLOWED_PROFILE_NAME=
WHATSAPP_ALLOWED_PHONE_LAST4=
WHATSAPP_GROUP_NAME=Kiosk Team Eko

# --- Docker server (docker-compose.yml) ----------------------------------------------------------
# Host folder the team drops exports + visit reports into (mounted read-only into the containers)
CSP_EXPORTS_DIR=/srv/csp-exports
CSP_HTTP_PORT=80
CSP_REPORT_TIMES=10:00,15:00
CSP_RUN_ON_START=true

# --- Dashboard login (set on the server; leave empty for local use on your own laptop) ------------
# Either a plain password, or (better) its SHA-256 hash:
#   python -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_SHA256=
